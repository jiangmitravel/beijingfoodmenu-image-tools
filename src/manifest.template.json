{
  "manifest_version": 3,
  "name": "{{EXTENSION_NAME}}",
  "short_name": "{{SHORT_NAME}}",
  "version": "{{VERSION}}",
  "description": "Professional batch image processing: compress, resize, convert formats. Privacy-first local processing. Grab images from any page.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Beijing Food Menu Team",
  "homepage_url": "{{HOMEPAGE_URL}}"
}